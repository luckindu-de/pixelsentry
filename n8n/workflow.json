{
  "name": "AI Responsive QA Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "b1a1a111-0000-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/scan",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"website\": \"https://example.com\",\n  \"pages\": [{ \"name\": \"Home\", \"path\": \"/\" }],\n  \"browsers\": [\"chromium\"],\n  \"languages\": [\"en\"],\n  \"viewports\": [\n    { \"name\": \"iPhone 12\", \"width\": 390, \"height\": 844 },\n    { \"name\": \"Desktop\", \"width\": 1366, \"height\": 768 }\n  ]\n}",
        "options": {}
      },
      "id": "b1a1a111-0000-4000-8000-000000000002",
      "name": "Start Scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "b1a1a111-0000-4000-8000-000000000003",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [400, 300],
      "webhookId": "b1a1a111-0000-4000-8000-0000000000wh"
    },
    {
      "parameters": {
        "url": "=http://localhost:3000/scan/{{ $node[\"Start Scan\"].json.scanId }}",
        "options": {}
      },
      "id": "b1a1a111-0000-4000-8000-000000000004",
      "name": "Check Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a111-0000-4000-8000-000000000005",
      "name": "Is Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "url": "=http://localhost:3000/report/{{ $node[\"Start Scan\"].json.scanId }}?format=json",
        "options": {}
      },
      "id": "b1a1a111-0000-4000-8000-000000000006",
      "name": "Get Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "notify-1",
              "name": "message",
              "type": "string",
              "value": "=QA scan {{ $json.scanId }} complete. Failed: {{ $json.summary.failed }} / {{ $json.summary.total }}. Open http://localhost:3000/report/{{ $json.scanId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a111-0000-4000-8000-000000000007",
      "name": "Notify",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1300, 200]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Start Scan", "type": "main", "index": 0 }]]
    },
    "Start Scan": {
      "main": [[{ "node": "Wait", "type": "main", "index": 0 }]]
    },
    "Wait": {
      "main": [[{ "node": "Check Progress", "type": "main", "index": 0 }]]
    },
    "Check Progress": {
      "main": [[{ "node": "Is Done?", "type": "main", "index": 0 }]]
    },
    "Is Done?": {
      "main": [
        [{ "node": "Get Report", "type": "main", "index": 0 }],
        [{ "node": "Wait", "type": "main", "index": 0 }]
      ]
    },
    "Get Report": {
      "main": [[{ "node": "Notify", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
