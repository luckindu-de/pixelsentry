# Vision provider API keys for the screenshot comparison feature.
# Add only the ones you want to compare. Ollama (local) needs no key.
#
# Google Gemini — FREE tier (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# OpenAI GPT-4o — PAID, requires billing (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Anthropic Claude Sonnet — PAID, requires credits (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Required only for user-scoped keys (sk-ant-usr-...). Copy the workspace ID
# from Console > Settings > Workspaces. Workspace keys (sk-ant-api...) don't need it.
# ANTHROPIC_WORKSPACE_ID=

# Optional model overrides (defaults shown):
# OLLAMA_MODEL=qwen2.5vl:7b
# GEMINI_MODEL=gemini-flash-latest   # or gemini-3-flash-preview (newest)
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-5   # a retired id falls back to the newest available Sonnet

# Login for authenticated pages (dashboards, funnels, create/generate).
# Global credentials used for every brand:
QA_EMAIL=
QA_PASSWORD=
# Per-brand overrides (optional) — e.g. QA_EMAIL_OQG, QA_PASSWORD_QCI:
# QA_EMAIL_OQG=
# QA_PASSWORD_OQG=

# JIRA (for scripts/pullJira.js) — rotate the token if it was ever exposed:
# JIRA_SITE=your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_TOKEN=
# JIRA_PROJECTS=OQG3,QCI,QGAI,QGC
